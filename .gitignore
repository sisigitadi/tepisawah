# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Vite / TypeScript
.vite/
*.local

# Environment files (never commit secrets)
.env
.env.*
!.env.example
!.env.development.example
!.env.preview.example
!.env.production.example

# Supabase local tooling
supabase/.branches/
supabase/.temp/

# Generated staging bootstrap doc (embeds the staging admin password; built by
# `pnpm build:staging` from the committed migrations + seed)
supabase/staging-bootstrap.sql

# Generated types (regenerated by scripts/generate-types.mjs)
packages/database/generated/**/*.d.ts

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs / coverage
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.vitest-cache/

# Test artifacts
test-results/
playwright-report/
