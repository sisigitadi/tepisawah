{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "https://staff.tepisawah.id/",
  "name": "Tepi Sawah — Portal Operasional Staf",
  "short_name": "Tepi Sawah Staf",
  "description": "Portal operasional terpadu staf Tepi Sawah Resto & Cafe: Meja Kasir, Layanan Pesanan Dapur, Layanan Meja, dan Panel Pengelola.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#183A1D",
  "theme_color": "#183A1D",
  "lang": "id",
  "dir": "ltr",
  "categories": ["business", "food", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Kasir & Layanan Meja",
      "short_name": "Kasir POS",
      "description": "Buka terminal kasir dan pembayaran pesanan saung",
      "url": "/pos",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Layar Pesanan Dapur",
      "short_name": "Dapur KDS",
      "description": "Antrean tiket masak koki dan status pesanan matang",
      "url": "/kitchen",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Panel Pengelola Restoran",
      "short_name": "Admin Resto",
      "description": "Katalog menu, meja saung, dan manajemen staf",
      "url": "/admin",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": []
}
