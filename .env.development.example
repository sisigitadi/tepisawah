# =============================================================================
# DEVELOPMENT environment — local Supabase / development project.
#
# Copy to `.env.development` (or `.env`) and fill in local values.
# NEVER commit the filled copy. Production values must never be used here
# (ENVIRONMENT_CONFIG.md §2.1, §3).
# =============================================================================

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# Server-side (local edge functions); leave empty until a local project exists.
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

APP_ENV=development
APP_BASE_URL=http://localhost:5173
