# =============================================================================
# PREVIEW / STAGING environment — PR previews, QA, UAT.
#
# Values are supplied as Vercel Preview Environment Variables; this file only
# documents the variable names. Never commit real staging credentials
# (ENVIRONMENT_CONFIG.md §2.2, §9).
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side; supplied by the Vercel Preview environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Dedicated staging project provisioning + CI smoke test.
#
# `scripts/setup-staging.mjs` builds the staging backend (schema + seed + the
# smoke-test admin) from these, and the CI smoke job (.github/workflows/ci.yml)
# reads its GitHub Secrets. Keep them out of Git — store real values in the
# GitHub repository secrets, never in this file.
# -----------------------------------------------------------------------------

# Target of `pnpm setup:staging` and the smoke test.
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=

# Service-role key: bypasses RLS so the run can delete the orders it creates.
STAGING_SERVICE_ROLE_KEY=

# Postgres password for the staging project; used only by setup-staging to
# apply migrations over the direct connection.
STAGING_DB_PASSWORD=

# Staff account the smoke test signs in as; must hold the admin role.
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=

APP_ENV=preview
APP_BASE_URL=https://preview.tepisawah.id
