# =============================================================================
# Tepi Sawah Resto & Cafe — environment variables
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Naming convention: UPPER_SNAKE_CASE (REPOSITORY_STRUCTURE.md §42).
# Variable registry: packages/config/src/env.ts (single source of truth).
#
# Per-environment templates: .env.development.example, .env.preview.example,
# .env.production.example (ENVIRONMENT_CONFIG.md §3).
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend apps (Vite — MUST be prefixed with VITE_)
# Consumed by: apps/web, apps/order, apps/pos, apps/kitchen, apps/waiter, apps/admin
# `VITE_*` values are embedded in the browser bundle: NEVER put a secret here
# (ENVIRONMENT_CONFIG.md §5).
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase edge functions (server-side only, never prefixed with VITE_)
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — never import it into an app
# (ENVIRONMENT_CONFIG.md §6, §34).
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Payment provider integration (server-side only; provider not yet decided)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Application metadata
# -----------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:5173
